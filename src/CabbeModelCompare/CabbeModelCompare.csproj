<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2026</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows7.0</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' != '2027'">net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CabbeModelCompare_$(RevitVersion)</AssemblyName>
    <RootNamespace>Cabbe.Revit.Compare</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <Authors>Cabbe</Authors>
    <Company>Cabbe BIM</Company>
    <Product>Cabbe Model Compare (ACC-style RVT comparison)</Product>
    <Description>Revit C# Add-in for visual model comparison with ACC-style diff, colors and UI</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(RevitVersion)' == '2024'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.3.60" PrivateAssets="All" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.3.60" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(RevitVersion)' == '2025'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.4.60" PrivateAssets="All" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.60" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(RevitVersion)' == '2026'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.4.10" PrivateAssets="All" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.4.10" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(RevitVersion)' == '2027'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.3.0" PrivateAssets="All" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.3.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Update="CabbeModelCompare.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
