<Window x:Class="Cabbe.Revit.Compare.UI.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modelljämförelse (ACC-stil)" 
        Height="760" Width="1080" 
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="HeaderCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResetButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#64748B"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Link Selector -->
            <RowDefinition Height="Auto"/> <!-- Summary Cards (ACC badges) -->
            <RowDefinition Height="*"/>    <!-- Main Content: Filters + Table -->
            <RowDefinition Height="220"/>  <!-- Bottom Parameter Diff Inspector -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Header & Link Selector -->
        <Border Grid.Row="0" Style="{StaticResource HeaderCard}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Modelljämförelse" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <Border Background="#E0E7FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="ACC-stil" FontSize="11" FontWeight="Bold" Foreground="#3730A3"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Jämför aktiv RVT-modell mot en inlänkad version och se ändringar, tillägg och borttagna objekt." 
                               FontSize="12" Foreground="#64748B" Margin="0,3,0,10"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Jämför mot länk:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#334155"/>
                        <ComboBox x:Name="CmbLinks" Width="360" Height="32" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Ladda om länkar" Click="BtnRefreshLinks_Click" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,4"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRunCompare" Content="Kör jämförelse" Click="BtnRunCompare_Click" Style="{StaticResource ActionButton}" Height="36" Margin="0,0,8,0"/>
                    <Button x:Name="BtnApplyColors" Content="Färga vy" Click="BtnApplyColors_Click" Style="{StaticResource ActionButton}" Background="#16A34A" Height="36" Margin="0,0,8,0"/>
                    <Button x:Name="BtnResetView" Content="Återställ vy" Click="BtnResetView_Click" Style="{StaticResource ResetButton}" Height="36"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Summary Badges (ACC-style) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tillagda (+X) -->
            <Border Grid.Column="0" Background="#DCFCE7" BorderBrush="#22C55E" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="BadgeAdded_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🟩" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtCountAdded" Text="+0 Tillagda" FontSize="15" FontWeight="Bold" Foreground="#15803D"/>
                        <TextBlock Text="Finns enbart i aktiv modell" FontSize="11" Foreground="#166534"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Ändrade (~X) -->
            <Border Grid.Column="1" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="BadgeModified_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🟧" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtCountModified" Text="~0 Ändrade" FontSize="15" FontWeight="Bold" Foreground="#B45309"/>
                        <TextBlock Text="Geometri eller parametrar skiljer" FontSize="11" Foreground="#92400E"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Borttagna (-X) -->
            <Border Grid.Column="2" Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="BadgeRemoved_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🟥" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtCountRemoved" Text="-0 Borttagna" FontSize="15" FontWeight="Bold" Foreground="#B91C1C"/>
                        <TextBlock Text="Visas som röda spökobjekt" FontSize="11" Foreground="#991B1B"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Alla / Återställ filter -->
            <Border Grid.Column="3" Background="#F1F5F9" BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Cursor="Hand" MouseLeftButtonUp="BadgeAll_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtCountTotal" Text="0 Totalt" FontSize="15" FontWeight="Bold" Foreground="#334155"/>
                        <TextBlock Text="Klicka för att visa alla" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Main Split Content: Categories Filter (Left) + DataGrid (Right) -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Categories Filter -->
            <Border Grid.Column="0" Style="{StaticResource HeaderCard}" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Kategorier att jämföra" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,8"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Alla" Click="BtnSelectAllCats_Click" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="Rensa" Click="BtnDeselectAllCats_Click" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsCategories">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,3" FontWeight="Normal" Foreground="#334155"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Items Table & Search -->
            <Border Grid.Column="1" Style="{StaticResource HeaderCard}">
                <DockPanel>
                    <!-- Search Bar & Filters -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtSearch" Height="30" VerticalContentAlignment="Center" Padding="8,2"
                                 ToolTip="Sök på typ, kategori, id..." TextChanged="TxtSearch_TextChanged"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtCurrentFilter" Text="Visar: Alla" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid x:Name="GridItems" AutoGenerateColumns="False" IsReadOnly="True" 
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionChanged="GridItems_SelectionChanged" MouseDoubleClick="GridItems_MouseDoubleClick"
                              Background="White" RowHeight="30" FontSize="12">
                        <DataGrid.Columns>
                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="Status" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBadgeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Kategori -->
                            <DataGridTextColumn Header="Kategori" Binding="{Binding CategoryName}" Width="130"/>

                            <!-- Typ & Familj -->
                            <DataGridTextColumn Header="Familj &amp; Typ" Binding="{Binding DisplayName}" Width="*"/>

                            <!-- Ändringssammanfattning -->
                            <DataGridTextColumn Header="Ändring" Binding="{Binding ChangeSummary}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 4. Parameter Diff Inspector (Bottom) -->
        <Border Grid.Row="3" Style="{StaticResource HeaderCard}" Margin="0,0,0,10">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Parameterjämförelse för valt objekt:" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtSelectedItemName" Text="Inget objekt markerat" FontSize="13" Foreground="#64748B"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnZoomToElement" Content="Zooma i Revit" Click="BtnZoomToElement_Click" Style="{StaticResource ActionButton}" Height="28" Padding="10,2" Margin="0,0,6,0"/>
                        <Button x:Name="BtnSelectInRevit" Content="Markera i Revit" Click="BtnSelectInRevit_Click" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,2"/>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="GridDiffs" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="#FAFAFA" RowHeight="26" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Parameter" Binding="{Binding ParameterName}" Width="200" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Gammalt värde (Länk)" Binding="{Binding OldValue}" Width="*"/>
                        <DataGridTextColumn Header="Nytt värde (Aktiv)" Binding="{Binding NewValue}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- 5. Status Bar -->
        <StatusBar Grid.Row="4" Background="Transparent" Padding="0">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="Redo. Välj en länk och klicka 'Kör jämförelse'." Foreground="#64748B" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
